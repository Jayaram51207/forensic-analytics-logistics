+// --- FORENSIC EVIDENCE (desktop mode only) ---
+// Sends a summary to app.py, which appends it to the evidence outbox. In a plain
+// browser there is no wrapper and nothing is captured.
+
+function shipmentRef() {
+  const el = document.getElementById('shipment-ref');
+  return el ? el.value.trim() : '';
+}
+
+function sendForensicEvent(action, payload) {
+  try {
+    const api = window.pywebview && window.pywebview.api;
+    if (api && api.forensic_event) {
+      api.forensic_event(JSON.stringify({ action, shipment_ref: shipmentRef() || null, payload }));
+    }
+  } catch (err) {
+    console.error('Forensic event not sent:', err.message);
+  }
+}
+
+// The first packing run happens before the desktop bridge exists; record it once the bridge is ready.
+window.addEventListener('pywebviewready', () => {
+  if (packingResults) {
+    sendForensicEvent('packing.run_completed', packingPayload(selectedContainer, manifestList, packingResults));
+  }
+});
+
